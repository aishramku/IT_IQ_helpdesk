# Copy to .env and adjust. Everything works with the defaults and NO API key.

# Database: SQLite by default. For PostgreSQL only this line changes:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/triageiq
# (leave empty to use data/triageiq.db)
DATABASE_URL=

# --- Optional LLM classifier (feature flag) ---------------------------------
# When USE_LLM=true AND a key is present, Claude classifies the PII-redacted
# text. Any invalid / out-of-schema output falls back to scikit-learn.
USE_LLM=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# --- Triage tuning ----------------------------------------------------------
# Leave empty to use the threshold chosen by ml/evaluate.py (metrics.json).
CONFIDENCE_THRESHOLD=
CORPORATE_DOMAIN=acmecorp.com
INCIDENT_WINDOW_MINUTES=15
INCIDENT_MIN_DISTINCT_REQUESTERS=10
DUPLICATE_SIMILARITY=0.72
INCIDENT_SIMILARITY=0.50

# --- API used by the stream simulator / dashboard links ---------------------
API_URL=http://127.0.0.1:8000
